# VITAL AI — backend environment.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every value is loaded and validated at boot (src/config/env.validation.ts).

# ----- Application -----
NODE_ENV=development
APP_NAME=VITAL AI API
PORT=3000
LOG_LEVEL=info

# ----- Database (Supabase Postgres) -----
# Local (docker-compose) example:
DATABASE_URL=postgres://vital:vital@localhost:5432/vital_ai
# Supabase example (enable SSL):
# DATABASE_URL=postgres://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=10

# ----- Redis (cache + BullMQ queues) -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ----- Supabase (Auth + Storage) — REQUIRED from Phase 1 (Auth & Onboarding) -----
# The app fails fast at boot if these are missing.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only secret. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: deep link the password-reset email should send the user to
# (e.g. vitalai://reset-password). Falls back to the project's Site URL when unset.
SUPABASE_PASSWORD_RESET_REDIRECT_URL=
# Storage bucket scan images are uploaded to. Create it in the Supabase dashboard
# (private is fine — the API signs a short-lived URL for the model to read).
SUPABASE_SCANS_BUCKET=scans

# ----- Generative model access — REQUIRED from Phase 3 (AI Layer) -----
# The backend is provider-agnostic: it talks to whichever service these four
# values point at, through an adapter chosen solely by AI_PROVIDER_ID. Switching
# to a different model service is an edit to this file and nothing else.
#
# AI_PROVIDER_ID selects the request/response format the endpoint speaks.
# Run the API once with an unrecognised value to have it print the ids it knows.
AI_PROVIDER_ID=
# Root URL of the inference endpoint, without a trailing slash.
AI_BASE_URL=
# Identifier of the model to call, exactly as that service names it.
AI_MODEL_NAME=
# Server-only secret. Never expose to the client.
AI_API_KEY=
# Per-request ceiling and transient-failure retry budget.
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# ----- Push notifications — Phase 4 (Progress & Engagement) -----
# Master switch. With this off, reminders still fire on schedule and are recorded
# as sent; they simply produce no device notification. Leave it off locally.
PUSH_ENABLED=false
# Expo push endpoint. Only change this to point at a proxy or a test double.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Server-only secret. Required only when the Expo project enforces push security
# (Expo dashboard → project → "Enhanced Security for Push Notifications").
EXPO_ACCESS_TOKEN=
PUSH_TIMEOUT_MS=15000
