# VITAL AI — backend environment.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every value is loaded and validated at boot (src/config/env.validation.ts).

# ----- Application -----
NODE_ENV=development
APP_NAME=VITAL AI API
PORT=3000
LOG_LEVEL=info

# ----- Database (Supabase Postgres) -----
# Local (docker-compose) example:
DATABASE_URL=postgres://vital:vital@localhost:5432/vital_ai
# Supabase example (enable SSL):
# DATABASE_URL=postgres://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=10

# ----- Redis (cache + BullMQ queues) -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ----- Supabase (Auth + Storage) — REQUIRED from Phase 1 (Auth & Onboarding) -----
# The app fails fast at boot if these are missing.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only secret. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: deep link the password-reset email should send the user to
# (e.g. vitalai://reset-password). Falls back to the project's Site URL when unset.
SUPABASE_PASSWORD_RESET_REDIRECT_URL=
# Storage bucket scan images are uploaded to. Create it in the Supabase dashboard
# (private is fine — the API signs a short-lived URL for the model to read).
SUPABASE_SCANS_BUCKET=scans

# ----- Generative model access — REQUIRED from Phase 3 (AI Layer) -----
# The backend is provider-agnostic: it talks to whichever service these four
# values point at, through an adapter chosen solely by AI_PROVIDER_ID. Switching
# to a different model service is an edit to this file and nothing else.
#
# AI_PROVIDER_ID selects the request/response format the endpoint speaks.
# Run the API once with an unrecognised value to have it print the ids it knows.
# Google Gemini: generate-content · OpenAI-compatible: chat-completions · Anthropic: messages
AI_PROVIDER_ID=
# Root URL of the inference endpoint, without a trailing slash.
# Gemini: https://generativelanguage.googleapis.com/v1beta
AI_BASE_URL=
# Identifier of the model to call, exactly as that service names it. Older
# Gemini generations are closed to newly issued keys, so check what yours can
# reach before assuming: GET {AI_BASE_URL}/models with the key in an
# `x-goog-api-key` header lists them. Gemini: gemini-3.5-flash
AI_MODEL_NAME=
# Server-only secret. Never expose to the client.
AI_API_KEY=
# Per-request ceiling and transient-failure retry budget.
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# ----- Spoonacular (food photography + measured nutrition + real recipes) -----
# The model decides what this person should eat and when; Spoonacular supplies
# the evidence behind each dish: the photograph, the measured macro composition,
# and the published method. Entirely optional — with no key the plan generates
# exactly as before, showing the model's own estimates and a designed tile.
# Get one at https://spoonacular.com/food-api. Server-only secret.
SPOONACULAR_API_KEY=
SPOONACULAR_BASE_URL=https://api.spoonacular.com
SPOONACULAR_TIMEOUT_MS=10000
# Ceiling on lookups one plan generation may spend, since the quota is metered
# daily. Meals past the ceiling keep the model's own estimate.
SPOONACULAR_MAX_LOOKUPS_PER_PLAN=56

# ----- Push notifications — Phase 4 (Progress & Engagement) -----
# Master switch. With this off, reminders still fire on schedule and are recorded
# as sent; they simply produce no device notification. Leave it off locally.
PUSH_ENABLED=false
# Expo push endpoint. Only change this to point at a proxy or a test double.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Server-only secret. Required only when the Expo project enforces push security
# (Expo dashboard → project → "Enhanced Security for Push Notifications").
EXPO_ACCESS_TOKEN=
PUSH_TIMEOUT_MS=15000

# ----- Rate limiting — Phase 5 (Production Hardening) -----
# Two layers: a coarse per-IP shield applied before authentication, and per-user
# budgets applied after it. On unless explicitly disabled, so an environment that
# never sets these is still protected.
RATE_LIMIT_ENABLED=true
# Where the client address is read from. MUST match the deployment topology.
# Leave empty when the service is exposed directly — trusting a forwarding header
# there lets any caller spoof a fresh address per request and evade the shield.
# Behind a load balancer set the number of proxy hops (usually 1), or a CIDR.
TRUST_PROXY=
# The pre-authentication shield. Deliberately generous: mobile clients share
# carrier NAT addresses, so a tight limit here would throttle innocent users.
RATE_LIMIT_GLOBAL_LIMIT=600
RATE_LIMIT_GLOBAL_TTL_SECONDS=60
RATE_LIMIT_GLOBAL_BLOCK_SECONDS=60
# Per user, per route. Sized for ordinary reads and writes.
RATE_LIMIT_DEFAULT_LIMIT=120
RATE_LIMIT_DEFAULT_TTL_SECONDS=60
RATE_LIMIT_DEFAULT_BLOCK_SECONDS=60
# One shared hourly budget across every endpoint that calls the model. This is a
# cost control as much as an abuse control.
RATE_LIMIT_AI_LIMIT=60
RATE_LIMIT_AI_TTL_SECONDS=3600
RATE_LIMIT_AI_BLOCK_SECONDS=300

# ----- Observability — Phase 5 (Production Hardening) -----
# Error tracking over the Sentry envelope API. Any Sentry-compatible ingest
# works (Sentry, GlitchTip, Bugsink). Leave empty to disable reporting entirely;
# errors are still logged locally either way.
SENTRY_DSN=
# Deployment name attached to every event. Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
# Build identifier attached to every event, so an incident ties to an exact
# build. Set automatically in the Docker image from the VERSION build argument.
SENTRY_RELEASE=
# Fraction of errors forwarded, 0–1. Lower it only to ride out a noisy incident.
SENTRY_SAMPLE_RATE=1
SENTRY_TIMEOUT_MS=5000
# Prometheus scrape endpoint at GET /metrics.
METRICS_ENABLED=true
# Bearer token the scrape requires. Metrics disclose route names, traffic volumes
# and error rates, so any internet-reachable deployment MUST set this.
METRICS_TOKEN=
